# ==============================================================================
# CRAZY TOURS & TRAVELS — ENVIRONMENT CONFIGURATION
# ==============================================================================

# SUPABASE / CLOUD POSTGRESQL (Production)
# Direct connection or Transaction Pooler URL from Supabase Project Settings -> Database
# Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# LOCAL POSTGRESQL FALLBACK (Development only)
PGUSER=postgres
PGPASSWORD=0907
PGHOST=localhost
PGPORT=5432
PGDATABASE=crazy_tours_db

# SERVER PORT
PORT=5000
NODE_ENV=production

# DATA PRIVACY & ACCESS CONTROL (CRITICAL)
# Secret key/passphrase for Admin Operations Console
ADMIN_PASSWORD=crazytours_admin_secure_2026
# HMAC-SHA256 Token Signing Secret for cryptographic session validation
JWT_SECRET=crazytours_session_signing_secret_998877_secure_key
